# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# Get a key at https://build.nvidia.com -> any Nemotron model -> "Get API Key".
# If a key is ever exposed, revoke it there and issue a new one. Do not paste
# keys into chat tools, screenshots, or commit messages.
NVIDIA_API_KEY=

# Which triage backend the pipeline uses: rules | nemotron
# `rules` needs no key. It is the offline fallback and the eval baseline.
DISPATCH_BACKEND=rules

# Point at the offline mock instead of NVIDIA to exercise the client with no
# network and no key:
#   python3 tools/mock_nemotron.py --port 8900
#   DISPATCH_NVIDIA_URL=http://127.0.0.1:8900/v1/chat/completions
# `dispatch eval` detects this and labels the arm "(mock endpoint)" so a mock
# run cannot be mistaken for a Nemotron result.
# DISPATCH_NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
# DISPATCH_NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Timezone for reading departure times out of documents. Falls back to system
# local time on machines with no tz database; `dispatch doctor` shows which.
DISPATCH_TZ=America/New_York
